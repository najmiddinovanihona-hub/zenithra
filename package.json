    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "satellite.js": "^5.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
