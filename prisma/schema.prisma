// ASTRO · Quyosh tizimi — ma'lumotlar bazasi sxemasi.
// Ishlab chiqishda SQLite (bitta fayl, hech narsa o'rnatish shart emas).
// PostgreSQL'ga o'tish: provider = "postgresql" qiling va .env dagi DATABASE_URL ni
// postgres://... ga almashtiring, so'ng `npm run db:push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  // "" — parol hali o'rnatilmagan (ro'yxatdan o'tish yakunlanmagan yoki admin parolni tiklashga majburlagan)
  passwordHash String       @default("") @map("password_hash")
  role         String       @default("user") // "user" | "admin"
  blocked      Boolean      @default(false)
  emailVerified Boolean     @default(false) @map("email_verified")
  lang         String       @default("uz")
  createdAt    DateTime     @default(now()) @map("created_at")
  lastSeenAt   DateTime?    @map("last_seen_at")
  sessions     Session[]
  progress     Progress[]
  quizResults  QuizResult[]
  settings     Settings?
  authCodes    AuthCode[]
  passwordSetups PasswordSetup[]

  @@map("users")
}

// Pochta kodi tasdiqlangach parol o'rnatish uchun bir martalik ruxsat (ro'yxatdan o'tish va parolni tiklash).
// id — brauzerdagi tokenning SHA-256 xeshi; qisqa muddatli.
model PasswordSetup {
  id        String   @id
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   // "register" | "reset"
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("password_setups")
}

// Harakatlar jurnali: kim (actorId), nima (action), kimga/nimaga (targetType + targetId), qachon, qaysi IP dan.
// Foydalanuvchi o'chirilsa ham yozuv qoladi (bog'lanish yo'q — actorEmail nusxasi saqlanadi).
model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  actorId    Int?     @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String   // masalan: "auth.login", "auth.login_failed", "admin.user.block", "content.question.create"
  targetType String?  @map("target_type") // "user" | "question" | ...
  targetId   String?  @map("target_id")
  ip         String?
  details    Json?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// Admin qo'shgan test savollari (3 tilli). scope: "quiz" — klassik test (level: easy|medium|hard),
// "dz" — darslik mavzusi testi (level: mavzu id, masalan "t07").
model QuizQuestion {
  id        Int      @id @default(autoincrement())
  scope     String
  level     String
  question  Json     // {uz, ru, en}
  options   Json     // [{uz, ru, en}, ...] — 2..6 ta
  correct   Int      // to'g'ri variant indeksi
  explain   Json?    // {uz, ru, en}
  active    Boolean  @default(true)
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scope, level])
  @@map("quiz_questions")
}

// Kod ichidagi (o'rnatilgan) savolni admin yashirishi: qid — savolning barqaror identifikatori.
model QuestionOverride {
  qid       String   @id
  hidden    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("question_overrides")
}

// Har bir savol bo'yicha javoblar statistikasi ("eng qiyin savollar" uchun).
model QuestionStat {
  qid       String   @id
  scope     String
  level     String
  text      String   // savolning o'zbekcha matni (ko'rsatish uchun nusxa)
  shown     Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scope, level])
  @@map("question_stats")
}

// Email orqali tasdiqlash kodi (ro'yxatdan o'tish va kirish). id — brauzerdagi "challenge" tokenining SHA-256 xeshi;
// kodning o'zi saqlanmaydi, faqat xeshi. 10 daqiqa amal qiladi, 5 ta noto'g'ri urinishdan keyin bekor bo'ladi.
model AuthCode {
  id        String   @id
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String   // "register" | "login"
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  sends     Int      @default(1)
  sentAt    DateTime @default(now()) @map("sent_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("auth_codes")
}

// Sessiya: cookie'dagi tasodifiy tokenning SHA-256 xeshi saqlanadi (token o'zi emas).
model Session {
  id        String   @id
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

// Darslik progressi: window.DZP dagi bitta mavzu yozuvi ({v, s, t, b, d}).
model Progress {
  userId    Int      @map("user_id")
  topicId   String   @map("topic_id")
  data      Json
  seen      Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
  @@map("progress")
}

model QuizResult {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  quizId    String   @map("quiz_id")
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([createdAt])
  @@map("quiz_results")
}

model Settings {
  userId    Int      @id @map("user_id")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// Osmon hodisalari eslatmalari (Web Push). Joylashuv FAQAT bildirishnoma yoqilganda va ~10 km aniqlikkacha
// yaxlitlangan holda saqlanadi; obuna bekor qilinsa yozuv o'chiriladi.
model PushSub {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  lat       Float
  lon       Float
  tz        Float
  lang      String   @default("uz")
  prefs     Json
  sent      Json     // yuborilgan eslatmalar kalitlari (takror yubormaslik uchun)
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_subs")
}

// Server sozlamalari (masalan, VAPID kalitlari) — bir martalik yaratiladi
model AppKV {
  key   String @id
  value String

  @@map("app_kv")
}
