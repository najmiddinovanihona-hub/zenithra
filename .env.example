# Nusxa oling: .env.example -> .env va qiymatlarni o'zgartiring.

# SQLite (ishlab chiqish). PostgreSQL uchun: postgresql://user:pass@localhost:5432/astro
# (prisma/schema.prisma dagi provider ni ham "postgresql" qiling).
DATABASE_URL="file:./dev.db"

PORT=3000

# production: cookie faqat HTTPS orqali yuboriladi (Secure). Internetga chiqarishda albatta production qiling.
NODE_ENV=development
# Majburan belgilash (ixtiyoriy): 1 — Secure cookie, 0 — oddiy
# COOKIE_SECURE=1

# Server proksi (nginx, Caddy) orqasida bo'lsa: proksilar soni (odatda 1) yoki "loopback".
# To'g'ri qo'yilmasa, login cheklovi hamma uchun umumiy bo'lib qoladi.
TRUST_PROXY=0

# Admin tayinlash .env orqali EMAS (email tasdiqlanmagani uchun xavfli edi), balki buyruq bilan:
#   npm run make-admin -- email@example.com

# Osmon eslatmalari (Web Push). Bo'sh qolsa — kalitlar birinchi ishga tushishda yaratilib, bazada saqlanadi.
# Boshqa serverga ko'chirganda shu kalitlarni saqlab qoling, aks holda eski obunalar ishlamay qoladi.
# Yaratish: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
