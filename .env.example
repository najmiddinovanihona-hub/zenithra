# Nusxa oling: .env.example -> .env va qiymatlarni o'zgartiring.

# SQLite (ishlab chiqish). PostgreSQL uchun: postgresql://user:pass@localhost:5432/astro
# (prisma/schema.prisma dagi provider ni ham "postgresql" qiling).
DATABASE_URL="file:./dev.db"

# Shu email bilan ro'yxatdan o'tgan foydalanuvchi avtomatik admin bo'ladi.
ADMIN_EMAIL="admin@example.com"

PORT=3000

# production: cookie faqat HTTPS orqali yuboriladi (Secure).
NODE_ENV=development

# Server proxy (masalan nginx) orqasida bo'lsa: 1 — rate-limit to'g'ri IP ni ko'rishi uchun.
TRUST_PROXY=0
